<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <WebView
        android:id="@+id/faiora_webview_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <LinearLayout
        android:id="@+id/faiora_boot_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#09090B"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ProgressBar
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:indeterminate="true"
            android:indeterminateTint="#F97316" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Loading Faiora"
            android:textAllCaps="true"
            android:textColor="#FFF7ED"
            android:textSize="10sp"
            android:letterSpacing="0.22" />
    </LinearLayout>

</FrameLayout>
