[debug] [2026-05-21T17:04:23.644Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/faiora-24f4a/rulesets {"name":"projects/faiora-24f4a/rulesets/0e680e6f-aa66-407b-997e-829806e1c10b","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return signedIn() && request.auth.uid == userId;\n    }\n\n    function isAdmin() {\n      return signedIn() && request.auth.token.email == 'admin@admin.com';\n    }\n\n    function keepsShareOwnership() {\n      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([\n        'ownerId',\n        'ownerEmail',\n        'ownerCollection',\n        'sourceCollection',\n        'sourceNoteId',\n        'noteId',\n        'id',\n        'publicShareToken',\n        'adminBackSync'\n      ]);\n    }\n\n    function publicShareEditAllowed() {\n      return signedIn()\n        && resource.data.isPublic == true\n        && resource.data.allowPublicEdit == true\n        && request.resource.data.isPublic == resource.data.isPublic\n        && request.resource.data.allowPublicEdit == resource.data.allowPublicEdit\n        && keepsShareOwnership();\n    }\n\n    match /public_shares/{token} {\n      allow read: if resource.data.isPublic == true\n        || isAdmin()\n        || (signedIn() && resource.data.ownerId == request.auth.uid);\n      allow create: if isAdmin()\n        || (signedIn() && request.resource.data.ownerId == request.auth.uid);\n      allow update: if isAdmin()\n        || (signedIn() && resource.data.ownerId == request.auth.uid)\n        || publicShareEditAllowed();\n      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);\n    }\n\n    match /users_public/{userId} {\n      allow read: if isAdmin() || isOwner(userId);\n      allow create, update: if isOwner(userId)\n        && request.resource.data.uid == userId;\n      allow create, update: if isAdmin();\n      allow delete: if isOwner(userId) || isAdmin();\n    }\n\n    match /faiora_metadata/{userId} {\n      allow read: if isAdmin() || isOwner(userId);\n      allow write: if isOwner(userId) || isAdmin();\n    }\n\n    match /sentNotifications/{docId} {\n      allow read: if signedIn();\n    }\n\n    match /fcmTokens/{userId} {\n      allow read, write: if isOwner(userId);\n    }\n\n    match /{collection}/{userId} {\n      allow read, write: if isOwner(userId);\n      allow read: if isAdmin()\n        && collection in [\n          'tasks',\n          'notes',\n          'users',\n          'userdata',\n          'users_public',\n          'faiora_data',\n          'user_metadata',\n          'metadata',\n          'profiles',\n          'user_accounts',\n          'leaderboard',\n          'faiora',\n          'planner',\n          'data',\n          'my_data',\n          'user_notes',\n          'planner_data',\n          'faiora_v1',\n          'cloud_notes'\n        ];\n      allow write: if isAdmin()\n        && collection in [\n          'tasks',\n          'notes',\n          'users',\n          'userdata',\n          'faiora_data',\n          'user_metadata',\n          'metadata',\n          'profiles',\n          'user_accounts',\n          'faiora',\n          'planner',\n          'data',\n          'my_data',\n          'user_notes',\n          'planner_data',\n          'faiora_v1',\n          'cloud_notes'\n        ];\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-21T17:04:22.922703Z","metadata":{"services":["cloud.firestore"]}}
