[debug] [2026-05-21T16:53:16.566Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/faiora-24f4a/rulesets {"name":"projects/faiora-24f4a/rulesets/f7e448fa-255a-48f4-81ae-a257a6347153","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return signedIn() && request.auth.uid == userId;\n    }\n\n    function isAdmin() {\n      return signedIn() && request.auth.token.email == 'admin@admin.com';\n    }\n\n    match /public_shares/{token} {\n      allow read: if true;\n      allow create, update: if signedIn();\n      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);\n    }\n\n    match /users_public/{userId} {\n      allow read: if isAdmin() || isOwner(userId);\n      allow create, update: if isOwner(userId)\n        && request.resource.data.uid == userId;\n      allow create, update: if isAdmin();\n      allow delete: if isOwner(userId) || isAdmin();\n    }\n\n    match /faiora_metadata/{userId} {\n      allow read: if isAdmin() || isOwner(userId);\n      allow write: if isOwner(userId) || isAdmin();\n    }\n\n    match /sentNotifications/{docId} {\n      allow read: if signedIn();\n    }\n\n    match /fcmTokens/{userId} {\n      allow read, write: if isOwner(userId);\n    }\n\n    match /{collection}/{userId} {\n      allow read, write: if isOwner(userId);\n      allow read: if isAdmin()\n        && collection in [\n          'tasks',\n          'notes',\n          'users',\n          'userdata',\n          'users_public',\n          'faiora_data',\n          'user_metadata',\n          'metadata',\n          'profiles',\n          'user_accounts',\n          'leaderboard',\n          'faiora',\n          'planner',\n          'data',\n          'my_data',\n          'user_notes',\n          'planner_data',\n          'faiora_v1',\n          'cloud_notes'\n        ];\n      allow write: if isAdmin()\n        && collection in [\n          'tasks',\n          'notes',\n          'users',\n          'userdata',\n          'faiora_data',\n          'user_metadata',\n          'metadata',\n          'profiles',\n          'user_accounts',\n          'faiora',\n          'planner',\n          'data',\n          'my_data',\n          'user_notes',\n          'planner_data',\n          'faiora_v1',\n          'cloud_notes'\n        ];\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-21T16:53:15.842223Z","metadata":{"services":["cloud.firestore"]}}
